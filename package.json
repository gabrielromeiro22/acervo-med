{
  "name": "acervo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "acervo:crawl": "node scripts/acervo/crawl.mjs",
    "acervo:catalog": "node scripts/acervo/catalog.mjs",
    "acervo:fetch": "node scripts/acervo/fetch.mjs",
    "acervo:parse": "node scripts/acervo/parse-afya.mjs && node scripts/acervo/parse-acervo.mjs",
    "acervo": "npm run acervo:crawl && npm run acervo:catalog && npm run acervo:fetch && npm run acervo:ocr && npm run acervo:parse && npm run acervo:build",
    "acervo:ocr": "node scripts/acervo/ocr.mjs",
    "acervo:build": "node scripts/acervo/build-app.mjs",
    "acervo:classificar": "node --env-file=.env.local scripts/acervo/classify.mjs --lote",
    "acervo:coletar": "node --env-file=.env.local scripts/acervo/classify.mjs --coletar && npm run acervo:build",
    "acervo:consolidar": "node --env-file=.env.local scripts/acervo/consolidate.mjs && npm run acervo:build"
  },
  "dependencies": {
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2",
    "sonner": "^2.0.5"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@eslint/js": "^9.25.0",
    "@tailwindcss/vite": "^4.1.8",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "tailwindcss": "^4.1.8",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5"
  }
}
